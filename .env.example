# Biến môi trường — BẢN MẪU. Copy thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ — khớp code: next.config.ts + src/auth/constants.ts
# Cập nhật khi:    code đọc một biến mới (process.env.X / os.getenv / os.Getenv / ...)
#
# HAI QUY TẮC
#   1. File này KHÔNG chứa giá trị thật. Chỉ tên biến + cách lấy giá trị.
#      `.env` là bản thật và đã bị .gitignore — giữ nguyên như vậy.
#   2. Danh sách này phải khớp CODE, không khớp tài liệu thiết kế. Biến nào code
#      không còn đọc thì xoá; biến nào code đọc mà thiếu ở đây là một cái bẫy.
#
# Mỗi biến ghi 3 thứ: ai đọc nó · bắt buộc khi nào · lấy giá trị ở đâu

# ─────────────────────────────────────────────────────────────
# Đường dẫn gốc của site
# ─────────────────────────────────────────────────────────────

# đọc bởi:      next.config.ts, src/auth/constants.ts (redirect_uri)
# bắt buộc khi: build để deploy lên GitHub Pages ("/web-game-duck-mines")
# lấy ở đâu:    workflow deploy tự đặt. Ở máy thì để TRỐNG: site chạy ở gốc "/".
#               Không có dấu "/" ở cuối.
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# Đăng nhập Ducker ID (tuỳ chọn, MẶC ĐỊNH TẮT — chỉ chạy ở máy)
# ─────────────────────────────────────────────────────────────
# OIDC Authorization Code + PKCE, public client (không backend, không client_secret).
# Mọi biến NEXT_PUBLIC_* đều CÔNG KHAI — Next inline chúng vào bundle lúc build.
# Tính năng chỉ bật khi cờ = "true" VÀ đủ cả bốn giá trị bên dưới; thiếu một cái là
# nút đăng nhập không hiện và game chạy như cũ. Workflow deploy KHÔNG truyền các biến
# này (ADR-0013), nên bản trên GitHub Pages không có nút.
#
# Cần làm ở Ducker ID để chạy thử ở máy:
#   - đăng ký client cho game này trong admin console, redirect URI
#       http://localhost:3300/   (pnpm dev -p 3300; cổng 3000 là của Ducker ID)
#       https://levananhduc.github.io/web-game-duck-mines/   (khi lên thật)
#   - thêm http://localhost:3300 vào CORS_ORIGINS của Ducker ID server

# Chỉ giá trị đúng chuỗi "true" mới bật.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=true
# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo).
NEXT_PUBLIC_DUCKER_ISSUER=http://localhost:3000
# client_id của game này, lấy ở admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
NEXT_PUBLIC_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà menu tài khoản liên kết tới (tương đối với ISSUER).
NEXT_PUBLIC_DUCKER_PROFILE_PATH=/profile

# ─────────────────────────────────────────────────────────────
# Tuỳ chọn — có mặc định trong code
# ─────────────────────────────────────────────────────────────

# đọc bởi:  scripts/check-bundle-size.mjs
# mặc định: 200 (chính là ngưỡng NFR-PERF-07, tính bằng kB gzip)
# dùng khi: muốn siết tạm cho chặt hơn lúc đang tối ưu. Đổi ngưỡng THẬT thì
#           sửa nfr.md, đừng sửa biến này rồi quên.
# BUNDLE_LIMIT_KB=

# Ngoài các biến trên, code không đọc biến môi trường nào khác: một trang tĩnh
# chạy hết ở trình duyệt, không server, không database, không API key —
# xem docs/03-design/architecture.md §1.
